# Copie para .env e preencha. Gere chaves com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCH_CLIENT_API_KEY=troque-esta-chave-cliente
ORCH_WORKER_API_KEY=troque-esta-chave-worker
ORCH_DB_PATH=orquestrador.db
# Segundos sem heartbeat até um job running ser considerado órfão
ORCH_ORPHAN_TIMEOUT_SECONDS=120
# Intervalo do reaper (recuperação de órfãos/timeouts)
ORCH_REAPER_INTERVAL_SECONDS=60
